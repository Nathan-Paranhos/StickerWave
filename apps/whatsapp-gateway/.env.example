# StickerWave WhatsApp Gateway Configuration
# Copy to .env and replace all secret placeholders before starting in production.

NODE_ENV=development
HOST=127.0.0.1
PORT=3001
PUBLIC_BASE_URL=http://127.0.0.1:3001

# Comma-separated browser origins allowed to call this gateway.
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:4173,http://localhost:4173,https://stickerwave.netlify.app

# Feature flag — keep true after PoC verification; set false for maintenance/kill-switch.
ENABLE_SOUND_STICKERS=true

# Admin secret required by /api/v1/whatsapp/* (connect, QR, disconnect, metrics, health-admin).
# MUST be a strong random value (>= 24 chars) in any shared/production environment.
GATEWAY_ADMIN_SECRET=change-me-admin-secret-at-least-24-chars

# Optional shared token for Studio client requests to /api/v1/stickers/* (leave empty for public CORS-gated Studio in local dev, or set HMAC/bearer in prod).
GATEWAY_PUBLIC_TOKEN=

# Encryption key (32+ bytes hex/passphrase) for Baileys WhatsApp session files at rest (AES-256-GCM).
GATEWAY_SESSION_SECRET=change-me-session-encryption-secret-32-chars

# Data persistence paths (never commit these directories to git)
DATA_DIR=./data
SESSION_DIR=./data/session
DB_PATH=./data/gateway.db

# FFmpeg / FFprobe binaries (leave blank to auto-detect on PATH / standard Windows/Linux paths)
FFMPEG_PATH=
FFPROBE_PATH=

# Media processing & queue limits
MAX_SECONDS=10
HARD_MAX_SECONDS=25
MAX_FRAMES=240
MAX_STICKER_BYTES=512000
MAX_STATIC_STICKER_BYTES=102400
MAX_AUDIO_BYTES=524288
MAX_VISUAL_UPLOAD_BYTES=26214400
MAX_AUDIO_UPLOAD_BYTES=20971520
AUDIO_KBPS=32
AUDIO_LEAD_MS=100

MAX_PARALLEL_JOBS=2
JOB_TIMEOUT_MS=90000
TMP_RETENTION_CHECK_MS=300000

# Opt-in recipient authorization
BOT_DISPLAY_NAME=StickerWave Bot
# Public bot WhatsApp number (digits only with country code, auto-populated after QR pair when connected)
WA_BOT_PHONE_HINT=
AUTHORIZATION_CODE_TTL_SEC=900
# Development/test helper: comma-separated E.164 test numbers or 'false' in production
AUTO_AUTHORIZE_DEV_NUMBERS=

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_SEND_PER_PHONE_PER_HOUR=12

# Logging & debugging (never log raw E.164 phone numbers or session secrets)
LOG_LEVEL=info
DEBUG_PROTOCOL=false
VERIFY_UPLOAD=false
