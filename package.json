{
  "name": "stickerwave",
  "version": "2.1.0-beta.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "npm@11.19.1",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build && node scripts/offline.mjs",
    "test": "node --import tsx --test qa/*.test.ts",
    "preview": "vite preview --host 0.0.0.0",
    "start": "node scripts/serve.mjs",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:dist": "node --test qa/dist.test.mjs",
    "test:browser": "node qa/browser.mjs"
  },
  "dependencies": {
    "@ffmpeg/core": "0.12.10",
    "@ffmpeg/ffmpeg": "0.12.15",
    "@fontsource-variable/manrope": "5.2.8",
    "@prisma/client": "^6.19.3",
    "fflate": "0.8.3",
    "libheif-js": "1.23.5",
    "lucide-react": "0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "0.187.0",
    "utif": "3.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.187.0",
    "@types/utif": "3.0.6",
    "@vitejs/plugin-react": "5.2.0",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.62.1",
    "prisma": "^6.19.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.8"
  }
}
